NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/certify?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_REGISTRATION_CODE=replace-with-a-private-admin-invitation-code
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ISSUER_PRIVATE_KEY=replace-with-the-testnet-contract-owner-private-key
# Optional when backend/config/contractDetails.json already has the address:
CONTRACT_ADDRESS=
